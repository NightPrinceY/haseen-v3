{"id":"2407.13097","authors":[{"_id":"669a03a96582d2ef7019bfc5","name":"Murtadha Ahmed","hidden":false},{"_id":"669a03a96582d2ef7019bfc6","name":"Saghir Alfasly","hidden":false},{"_id":"669a03a96582d2ef7019bfc7","name":"Bo Wen","hidden":false},{"_id":"669a03a96582d2ef7019bfc8","name":"Jamaal Qasem","hidden":false},{"_id":"669a03a96582d2ef7019bfc9","name":"Mohammed Ahmed","hidden":false},{"_id":"669a03a96582d2ef7019bfca","name":"Yunfeng Liu","hidden":false}],"publishedAt":"2024-07-18T02:13:50.000Z","title":"AlcLaM: Arabic Dialectal Language Model","summary":"Pre-trained Language Models (PLMs) are integral to many modern natural\nlanguage processing (NLP) systems. Although multilingual models cover a wide\nrange of languages, they often grapple with challenges like high inference\ncosts and a lack of diverse non-English training data. Arabic-specific PLMs are\ntrained predominantly on modern standard Arabic, which compromises their\nperformance on regional dialects. To tackle this, we construct an Arabic\ndialectal corpus comprising 3.4M sentences gathered from social media\nplatforms. We utilize this corpus to expand the vocabulary and retrain a\nBERT-based model from scratch. Named AlcLaM, our model was trained using only\n13 GB of text, which represents a fraction of the data used by existing models\nsuch as CAMeL, MARBERT, and ArBERT, compared to 7.8%, 10.2%, and 21.3%,\nrespectively. Remarkably, AlcLaM demonstrates superior performance on a variety\nof Arabic NLP tasks despite the limited training data. AlcLaM is available at\nGitHub https://github.com/amurtadha/Alclam and HuggingFace\nhttps://huggingface.co/rahbi.","upvotes":0,"discussionId":"669a03aa6582d2ef7019c005","githubRepo":"https://github.com/amurtadha/alclam","githubRepoAddedBy":"auto","ai_summary":"A dialectal Arabic corpus is used to train a BERT-based model named AlcLaM, enhancing performance on Arabic NLP tasks with limited data.","ai_keywords":["Pre-trained Language Models","multilingual models","BERT","dialectal Arabic","inference costs","training data","vocabulary expansion","HuggingFace"],"ai_summary_model":"Qwen/Qwen2.5-Coder-32B-Instruct","githubStars":8,"linkedModels":[{"author":"rahbi","authorData":{"_id":"63f88396da440a47e9f5e8ef","avatarUrl":"/avatars/c07edf53efb7af61cecbe71f8bc23d51.svg","fullname":"Murtadha Ahmed","name":"rahbi","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"followerCount":2,"isUserFollowing":false},"downloads":13,"gated":false,"id":"rahbi/alclam-base-v2","availableInferenceProviders":[],"lastModified":"2024-07-23T10:24:54.000Z","likes":2,"pipeline_tag":"fill-mask","private":false,"repoType":"model","isLikedByUser":false,"widgetOutputUrls":[],"numParameters":162942880},{"author":"rahbi","authorData":{"_id":"63f88396da440a47e9f5e8ef","avatarUrl":"/avatars/c07edf53efb7af61cecbe71f8bc23d51.svg","fullname":"Murtadha Ahmed","name":"rahbi","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"followerCount":2,"isUserFollowing":false},"downloads":17,"gated":false,"id":"rahbi/alclam-base-v1","availableInferenceProviders":[],"lastModified":"2024-07-19T06:11:52.000Z","likes":2,"pipeline_tag":"fill-mask","private":false,"repoType":"model","isLikedByUser":false,"widgetOutputUrls":[],"numParameters":126031648},{"author":"rahbi","authorData":{"_id":"63f88396da440a47e9f5e8ef","avatarUrl":"/avatars/c07edf53efb7af61cecbe71f8bc23d51.svg","fullname":"Murtadha Ahmed","name":"rahbi","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"followerCount":2,"isUserFollowing":false},"downloads":9,"gated":false,"id":"rahbi/alclam-base-v1-DID","availableInferenceProviders":[],"lastModified":"2024-07-22T16:16:08.000Z","likes":1,"pipeline_tag":"text-classification","private":false,"repoType":"model","isLikedByUser":false,"widgetOutputUrls":[],"numParameters":125985033},{"author":"rahbi","authorData":{"_id":"63f88396da440a47e9f5e8ef","avatarUrl":"/avatars/c07edf53efb7af61cecbe71f8bc23d51.svg","ful